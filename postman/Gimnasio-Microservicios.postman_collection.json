{
  "info": {
    "_postman_id": "9a2f8f4a-9c3e-4a7b-8f2b-6a2b7c8e2b10",
    "name": "Gimnasio - Microservicios",
    "description": "Pruebas de los 4 microservicios del taller (ms-membresias, ms-programacion, ms-personal, ms-inventario). Cada microservicio tiene su propia carpeta con casos válidos y casos que verifican las invariantes de dominio (Value Objects, factory methods, enum de especialidad, etc). Antes de correr la carpeta ms-programacion, ms-personal debe estar levantado, porque ms-programacion valida entrenadorId contra el contexto Personal por REST. Las pruebas asumen una base H2 en memoria recién arrancada (DataLoader sembrando los ids 1 y 2 en cada servicio).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "ms_membresias_url", "value": "http://localhost:8081" },
    { "key": "ms_programacion_url", "value": "http://localhost:8082" },
    { "key": "ms_personal_url", "value": "http://localhost:8083" },
    { "key": "ms_inventario_url", "value": "http://localhost:8084" }
  ],
