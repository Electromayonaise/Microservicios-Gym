      "item": [
        {
          "name": "GET Listar miembros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ms_membresias_url}}/api/miembros",
              "host": ["{{ms_membresias_url}}"],
              "path": ["api", "miembros"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('La respuesta es un arreglo', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Registrar miembro - valido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Pedro Ruiz\",\n    \"email\": \"pedro.ruiz+{{$timestamp}}@email.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{ms_membresias_url}}/api/miembros",
              "host": ["{{ms_membresias_url}}"],
              "path": ["api", "miembros"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('El miembro creado tiene id', function () {",
                  "    pm.expect(body).to.have.property('id');",
                  "});",
                  "pm.test('fechaInscripcion fue asignada por el agregado', function () {",
                  "    pm.expect(body.fechaInscripcion).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
